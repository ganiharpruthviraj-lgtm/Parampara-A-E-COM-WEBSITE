# ==============================================================================
# Parampara (परंपरा) — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in this directory:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Examples:
#   Local:   mongodb://127.0.0.1:27017/parampara
#   Atlas:   mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/parampara?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/parampara

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate a secure 64-byte hex key in your terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_character_random_hex_string_here

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Production SMS Gateway (Fast2SMS & Twilio)
# ------------------------------------------------------------------------------
# Fast2SMS (India domestic SMS for OTP & dispatch notifications)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio SMS Gateway (International / global fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Email Gateway (Gmail SMTP / Custom SMTP) for Password Reset & Verification
# ------------------------------------------------------------------------------
# To enable real Gmail delivery:
# 1. Provide your Gmail address below
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the App Password into EMAIL_PASS (without spaces)
# Note: If left unset, the backend runs in Smart Demo Mode displaying OTP codes in responses.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM_NAME="Parampara Heritage Collective"

# ------------------------------------------------------------------------------
# Payment Gateway & Artisan Payouts (Razorpay & RazorpayX)
# ------------------------------------------------------------------------------
# Get your API keys at: https://dashboard.razorpay.com/app/keys
# For development/testing: use Test Mode keys (rzp_test_...)
# For production: use Live Mode keys (rzp_live_...)
# Webhook Secret configured at: https://dashboard.razorpay.com/app/webhooks
# RazorpayX Account: Merchant business/virtual account number for automated 70% artisan payouts
# Note: If left unset, the backend runs in Smart Sandbox Simulation Mode.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ACCOUNT_NUMBER=2323230044455566

# ------------------------------------------------------------------------------
# YouPI-PG Payment Gateway (Zero Platform Fee & Direct Artisan UPI Routing)
# Repository: https://github.com/youpi-pg/YouPI-PG
# ------------------------------------------------------------------------------
YOUPI_GATEWAY_URL=http://localhost:6100
YOUPI_MERCHANT_KEY=yp_parampara_heritage_2026
YOUPI_MERCHANT_VPA=9901402758@yespop

# ------------------------------------------------------------------------------
# Logistics & Courier Gateways (India Post Speed Post & Shiprocket)
# ------------------------------------------------------------------------------
# Shiprocket API: https://app.shiprocket.in/api-user
# Used for automated BlueDart/Delhivery air waybills & tracking
SHIPROCKET_EMAIL=your_shiprocket_email@parampara.org
SHIPROCKET_PASSWORD=your_shiprocket_password_here

# India Post Speed Post API / Corporate Customer Account
# Guarantees coverage across all 19,000+ Indian postal PIN codes & rural clusters
INDIA_POST_CLIENT_ID=your_india_post_corporate_client_id
INDIA_POST_API_KEY=your_india_post_api_key_here

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,https://ganiharpruthviraj-lgtm.github.io

