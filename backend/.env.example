# ==============================================================================
# Parampara (परंपरा) — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in this directory:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Examples:
#   Local:   mongodb://127.0.0.1:27017/parampara
#   Atlas:   mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/parampara?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/parampara

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate a secure 64-byte hex key in your terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_character_random_hex_string_here

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Email Gateway (Gmail SMTP / Custom SMTP) for Password Reset & Verification
# ------------------------------------------------------------------------------
# To enable real Gmail delivery:
# 1. Provide your Gmail address below
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the App Password into EMAIL_PASS (without spaces)
# Note: If left unset, the backend runs in Smart Demo Mode displaying OTP codes in responses.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM_NAME="Parampara Heritage Collective"

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,https://ganiharpruthviraj-lgtm.github.io

