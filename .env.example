# ==============================================================================
# Parampara (परंपरा) — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` before starting the server.
#
# Command:
#   cp .env.example backend/.env
# ==============================================================================

# Server Network Configuration
# Port on which the Express REST API server will listen
PORT=5000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Replace with your local instance or MongoDB Atlas connection string.
# Note: In development, if MONGO_URI is omitted or offline, the server
# gracefully falls back to local or in-memory configurations.
#
# Examples:
#   Local:   mongodb://127.0.0.1:27017/parampara
#   Atlas:   mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/parampara?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/parampara

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
# High-entropy random secret key used to sign and verify JSON Web Tokens (JWT).
# IMPORTANT: Never commit your actual JWT_SECRET to source control!
#
# Generate a secure 64-byte hex key in your terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_character_random_hex_string_here

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID for validating Google Sign-In identity tokens
# Obtain this from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to make API requests in production.
# In development (NODE_ENV=development), localhost origins are allowed by default.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,https://ganiharpruthviraj-lgtm.github.io
