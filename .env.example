# ==============================================================================
# Parampara (परंपरा) — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` before starting the server.
#
# Command:
#   cp .env.example backend/.env
# ==============================================================================

# Server Network Configuration
PORT=5000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/parampara

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_64_character_random_hex_string_here

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMS Gateway Integration for Physical Mobile OTP Delivery
# Fast2SMS (India DLTR Route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio SMS Gateway (Global)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,https://ganiharpruthviraj-lgtm.github.io
